# ========================= Flowmentor CRM — variáveis de ambiente =========================
# Copie para .env (docker compose) ou backend/.env (execução local). NUNCA versione o .env real.

# --- Aplicação ---
ENVIRONMENT=production                  # development | test | production
PUBLIC_BASE_URL=https://crm.suaempresa.com.br
CORS_ORIGINS=["https://crm.suaempresa.com.br"]
SECRET_KEY=                              # openssl rand -hex 48  (OBRIGATÓRIO em produção)

# --- Banco / filas ---
POSTGRES_PASSWORD=                       # usado pelo docker-compose
DATABASE_URL=postgresql+asyncpg://flowmentor:SENHA@db:5432/flowmentor
REDIS_URL=redis://redis:6379/0           # habilita Redis Streams, rate limit distribuído e Socket.IO multi-worker

# --- Criptografia (envelope encryption) ---
# Formato: "kid:base64(32 bytes)[,kid_antigo:base64]" — a primeira chave é a ativa; as demais só decifram (rotação).
# Gerar: python -c "import os,base64;print('k1:'+base64.urlsafe_b64encode(os.urandom(32)).decode())"
KEK_KEYS=

# --- Primeiro acesso (criado apenas se o banco estiver vazio) ---
BOOTSTRAP_ADMIN_EMAIL=admin@suaempresa.com.br
BOOTSTRAP_ADMIN_PASSWORD=                # obrigatória em produção; em dev, vazia = gerada e registrada no log
DEMO_USER_PASSWORD=                      # só com SEED_DEMO_DATA=true; vazia = gerada e registrada no log
BOOTSTRAP_ORG_NAME=Flowmentor
SEED_DEMO_DATA=false

# --- WhatsApp Cloud API (Meta) ---
META_MODE=live                           # sandbox = não chama a Meta (dev/demonstração)
META_APP_ID=
META_APP_SECRET=                         # valida X-Hub-Signature-256 e troca o code do Embedded Signup
META_WEBHOOK_VERIFY_TOKEN=               # o mesmo token informado no painel da Meta
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_GRAPH_VERSION=v21.0

# --- Mídias ---
STORAGE_BACKEND=s3                       # local | s3
STORAGE_BUCKET=flowmentor-media
MINIO_PASSWORD=                          # obrigatória apenas com o profile `s3` do docker-compose (MinIO local)
STORAGE_S3_ENDPOINT=                     # vazio = AWS S3; para MinIO: http://minio:9000
STORAGE_S3_REGION=sa-east-1
MEDIA_URL_TTL_SECONDS=900
MEDIA_RETENTION_DAYS=365

# --- IA (opcional: resumos, sentimento, intenção). Sem chave, usa heurísticas locais ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

# --- Regras de negócio ---
DISCOUNT_AUTO_APPROVE_MAX_PCT=10
CONSULTING_HOURLY_RATE_REF=300.00
