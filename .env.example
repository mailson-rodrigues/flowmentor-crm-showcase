# ========================= Flowmentor CRM — environment variables =========================
# Copy to .env (docker compose) or backend/.env (local run). NEVER commit the real .env.

# --- Application ---
ENVIRONMENT=production                  # development | test | production
PUBLIC_BASE_URL=https://crm.yourcompany.com
CORS_ORIGINS=["https://crm.yourcompany.com"]
SECRET_KEY=                              # openssl rand -hex 48  (REQUIRED in production)

# --- Database / queues ---
POSTGRES_PASSWORD=                       # used by docker-compose
DATABASE_URL=postgresql+asyncpg://flowmentor:PASSWORD@db:5432/flowmentor
REDIS_URL=redis://redis:6379/0           # enables Redis Streams, distributed rate limiting and multi-worker Socket.IO

# --- Encryption (envelope encryption) ---
# Format: "kid:base64(32 bytes)[,old_kid:base64]" — the first key is the active one; the others only decrypt (rotation).
# Generate: python -c "import os,base64;print('k1:'+base64.urlsafe_b64encode(os.urandom(32)).decode())"
KEK_KEYS=

# --- First access (created only if the database is empty) ---
BOOTSTRAP_ADMIN_EMAIL=admin@yourcompany.com
BOOTSTRAP_ADMIN_PASSWORD=                # required in production; in dev, empty = generated and logged
DEMO_USER_PASSWORD=                      # only with SEED_DEMO_DATA=true; empty = generated and logged
BOOTSTRAP_ORG_NAME=Flowmentor
SEED_DEMO_DATA=false

# --- WhatsApp Cloud API (Meta) ---
META_MODE=live                           # sandbox = does not call Meta (dev/demo)
META_APP_ID=
META_APP_SECRET=                         # validates X-Hub-Signature-256 and exchanges the Embedded Signup code
META_WEBHOOK_VERIFY_TOKEN=               # the same token entered in the Meta dashboard
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_GRAPH_VERSION=v21.0

# --- Media ---
STORAGE_BACKEND=s3                       # local | s3
STORAGE_BUCKET=flowmentor-media
MINIO_PASSWORD=                          # required only with the docker-compose `s3` profile (local MinIO)
STORAGE_S3_ENDPOINT=                     # empty = AWS S3; for MinIO: http://minio:9000
STORAGE_S3_REGION=sa-east-1
MEDIA_URL_TTL_SECONDS=900
MEDIA_RETENTION_DAYS=365

# --- AI (optional: summaries, sentiment, intent). Without a key, local heuristics are used ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

# --- Business rules ---
DISCOUNT_AUTO_APPROVE_MAX_PCT=10
CONSULTING_HOURLY_RATE_REF=300.00
